{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // The mock provider in compose.dev.yaml, which has to be up before /admin/login
  // will do anything: `docker compose -f compose.dev.yaml up -d`. It accepts any
  // client id, any secret and any username, so neither value below is a
  // credential — they are here so the shape of the configuration is the same one
  // a deployment fills in. See docs/running-locally.md.
  "Authentication": {
    "Authority": "http://localhost:5400/default",
    "ClientId": "kairos-development",
    "ClientSecret": "development-placeholder"
  },
  // PUBLIC. This key is committed, it is in every clone of this repository and in
  // every fork of it, and anything it has ever encrypted must be treated as
  // plaintext. It exists so that `dotnet run` works without a shell incantation
  // and so that credentials encrypted before a restart can still be read after
  // one — a key minted per run turns every restart into a re-connect. It is
  // overridden by Security__SecretKey in the environment everywhere else, and
  // appsettings.Development.json is only ever read when ASPNETCORE_ENVIRONMENT is
  // Development. Never set this value outside Development.
  "Security": {
    "SecretKey": "ZGV2ZWxvcG1lbnQtb25seS1rZXktbm90LXNlY3JldCE="
  }
}
