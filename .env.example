# Copy to .env and fill in. A setting's path uses "__" where the configuration
# path has ":", so Authentication:Authority is Authentication__Authority.

# --- Required: Kairos refuses to start without these four ---

# Encrypts stored integration credentials. Generate with: openssl rand -base64 32
# Keep it: a new key cannot read what the old one encrypted.
Security__SecretKey=

# The OIDC provider the operator signs in with. Register a client with redirect
# URI <your origin>/signin-oidc and the "groups" scope.
Authentication__Authority=
Authentication__ClientId=
Authentication__ClientSecret=

# --- Operator ---

# The group, in the token's "groups" claim, whose members may administer Kairos.
# Authorization__AdminGroup=kairos-users
# Narrows the group further to these subject ids (the token's "sub").
# Authorization__AdminSubjects__0=

# --- Behind a reverse proxy ---

# The proxy's address, so its X-Forwarded-* headers are believed. Without it
# sign-in redirects to http:// and every visitor shares one rate-limit bucket.
# Proxy__KnownProxies__0=
# Or a whole network, as CIDR: 10.0.0.0/8
# Proxy__KnownNetworks__0=
# The public origin, for links the admin hands out and links in mail. Without it
# the admin uses the browser's origin and no mail is sent.
# App__PublicBaseUrl=https://book.example.com

# --- Mail: off unless Host, From and a public origin are all set ---

# Email__Host=
# Email__Port=587
# Email__Username=
# Email__Password=
# Email__From=
# Overrides App__PublicBaseUrl for links in mail alone.
# Email__PublicBaseUrl=https://book.example.com

# --- Google Calendar and Meet ---

# Integrations__Google__ClientId=
# Integrations__Google__ClientSecret=
# Exactly as registered on the Google OAuth client.
# Integrations__Google__RedirectUri=https://book.example.com/api/v1/integrations/google/callback

# --- Webhooks ---

# Receives a POST for each booking event.
# Webhooks__Url=
# HMAC-SHA256 key; the signature arrives in X-Kairos-Signature.
# Webhooks__Secret=
